# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
PORT=3000

# ==========================================
# Redis Configuration
# ==========================================
REDIS_URL=redis://redis:6379
# If using a password:
# REDIS_URL=redis://:password@host:port

# ==========================================
# Security Settings
# ==========================================
# Permitted domains for SSRF protection
ALLOWED_DOMAINS=youtube.com,youtu.be,tiktok.com,instagram.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# yt-dlp Options
# ==========================================
# If you want to use cookies for platforms that block anonymous downloads
# Mount a cookies.txt file to the container and specify its path here:
# YTDLP_COOKIES_FILE=/app/backend/cookies.txt
